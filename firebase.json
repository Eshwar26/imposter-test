{
  "database": { "rules": "database.rules.json" },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*.log"], "predeploy": ["node tools/copy-data.js"] }
  ],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [ { "source": "**", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] } ]
  }
}